{
  "name": "sotto-sotto-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "content:report": "tsx scripts/content-report.ts",
    "content:guard": "tsx scripts/content-report.ts --guard",
    "images": "tsx scripts/images.ts",
    "video": "bash scripts/video.sh",
    "map": "tsx scripts/map.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "build": "npm run content:guard && next build && tsx scripts/emit-headers.ts",
    "build:staging": "SITE_ENV=staging npm run build",
    "build:production": "SITE_ENV=production npm run build",
    "start": "npx --yes serve@14.2.4 out -l 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run contrast"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
